{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course Board manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "chapters"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "$ref": "#/definitions/id" },
    "title": { "$ref": "#/definitions/text" },
    "description": { "$ref": "#/definitions/text" },
    "theme": { "type": "string", "pattern": "\\.css$" },
    "extension": { "type": "string", "pattern": "\\.m?js$" },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "lessons"],
        "properties": {
          "title": { "$ref": "#/definitions/text" },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/id" }
          }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "pattern": "\\S" }
  }
}
