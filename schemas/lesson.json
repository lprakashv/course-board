{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course Board lesson front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title"
  ],
  "properties": {
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "pattern": "\\S"
    },
    "data": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/jsonValue"
      }
    }
  },
  "definitions": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/jsonValue"
          }
        }
      ]
    }
  }
}
