{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course Board import bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "lessons"],
  "properties": {
    "$schema": { "type": "string" },
    "manifest": { "$ref": "manifest.json" },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "steps"],
        "properties": {
          "id": { "$ref": "manifest.json#/definitions/id" },
          "title": { "$ref": "lesson.json#/properties/title" },
          "summary": { "$ref": "lesson.json#/properties/summary" },
          "data": { "$ref": "lesson.json#/properties/data" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "text"],
              "properties": {
                "id": { "$ref": "step.json#/properties/id" },
                "title": { "type": "string", "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$" },
                "text": { "$ref": "step.json#/definitions/text" },
                "diagram": { "$ref": "step.json#/properties/diagram" },
                "snippet": { "$ref": "step.json#/properties/snippet" },
                "data": { "$ref": "step.json#/properties/data" }
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "contentFiles": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
